decisiondebt.52.202.25.181.sslip.io {
    encode zstd gzip
    reverse_proxy decisiondebt-public-api:8000 {
        header_up X-Forwarded-For {remote_host}
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
    log {
        output file /data/decisiondebt/access.jsonl {
            roll_size 5MiB
            roll_keep 5
        }
        format json
    }
}
